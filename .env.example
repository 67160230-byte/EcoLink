# MONGO_URI=mongodb://ecolink-db:27017/ecolink_db

# Security & JWT Secret
JWT_SECRET=ecolink_jwt_secret_key_2026_super_secure

# Google OAuth Client ID
GOOGLE_CLIENT_ID=833836445798-rodo4r5oe89iitq7ontqfvoonp3lnr68.apps.googleusercontent.com

# Environment (development / production)
NODE_ENV=development
