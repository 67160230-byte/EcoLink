{
  "name": "ecolink-api",
  "version": "1.0.0",
  "description": "REST API for EcoLink Industrial Waste Matching Platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:db": "docker-compose up -d ecolink-db ecolink-mongo-express",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "express",
    "mongodb",
    "waste-management",
    "sustainability",
    "circular-economy",
    "docker"
  ],
  "author": "EcoLink Team",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "multer": "^2.2.0"
  }
}
